# Generated by Bitwarden
POSTGRES_USER=Starlight
POSTGRES_PASSWORD=pass
POSTGRES_DB=
POSTGRES_HOST=localhost
DB_PORT=5420

POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${DB_PORT}/${POSTGRES_DB}"

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# NEXTAUTH_URL and AUTH_TRUST_HOST are needed in prod
NEXTAUTH_URL="${NEXT_PUBLIC_BASE_URL}"
AUTH_TRUST_HOST="${NEXT_PUBLIC_BASE_URL}"
# NextAuth — generate with: npx auth secret
AUTH_SECRET="xxx"
BETTER_AUTH_SECRET="${AUTH_SECRET}"
NEXTAUTH_SECRET="${AUTH_SECRET}"

# Google OAuth — https://console.cloud.google.com/
# Origin should have http://localhost:XXXX and the https domain when configuring the Web client
# Redirect URI should have http://localhost:XXX/api/auth/callback/google and https using the same pathname
AUTH_GOOGLE_ID="xxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="xxx"

# Google Sheet holding the store's figures (one tab per month: "Novembre", "Janvier 27", …)
# 1. https://console.cloud.google.com/ → create a project → enable "Google Sheets API"
# 2. IAM & Admin → Service Accounts → create one → Keys → Add key → JSON
# 3. Share the spreadsheet (read-only "Viewer") with the service account's email
# GOOGLE_SHEET_ID is the long id in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
# Set GOOGLE_SHEET_ID="demo" to try the app with generated figures and no Google setup.
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxx@xxx.iam.gserviceaccount.com"
# The JSON key's "private_key", on one line with literal \n
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"
# Year for month tabs that don't name one, when no tab does (defaults to the current year)
GOOGLE_SHEET_DEFAULT_YEAR=""

# Comma-separated emails allowed to sign in (everyone else is refused)
ALLOWED_EMAILS="someone@example.com"
