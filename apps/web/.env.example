# Generated by Bitwarden
POSTGRES_USER=Starlight
POSTGRES_PASSWORD=pass
POSTGRES_DB=
POSTGRES_HOST=localhost
DB_PORT=5420

POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${DB_PORT}/${POSTGRES_DB}"

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# NEXTAUTH_URL and AUTH_TRUST_HOST are needed in prod
NEXTAUTH_URL="${NEXT_PUBLIC_BASE_URL}"
AUTH_TRUST_HOST="${NEXT_PUBLIC_BASE_URL}"
# NextAuth — generate with: npx auth secret
AUTH_SECRET="xxx"
BETTER_AUTH_SECRET="${AUTH_SECRET}"
NEXTAUTH_SECRET="${AUTH_SECRET}"

# Google OAuth — https://console.cloud.google.com/
# Origin should have http://localhost:XXXX and the https domain when configuring the Web client
# Redirect URI should have http://localhost:XXX/api/auth/callback/google and https using the same pathname
AUTH_GOOGLE_ID="xxx.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="xxx"

# /!\ You can only test Apple Auth in prod (https) /!\

# Create App and activate Sign In with Apple (https://developer.apple.com/account/resources/identifiers/list/bundleId)
# -> ID should be TLD.DOMAIN
# -> Config with this HTTPS url: https://DOMAIN.TLD/api/auth/callback/apple
# Create Service ID and edit it to add Sign In with Apple (https://developer.apple.com/account/resources/identifiers/list/serviceId)
# -> ID should be TLD.DOMAIN.web
# -> Domain should be DOMAIN.TLD
# -> Return URL should be : https://DOMAIN.TLD/api/auth/callback/apple and https://DOMAIN.TLD/
# Create a Key (https://developer.apple.com/account/resources/authkeys/list)
# -> Paste the new KEY ID to APPLE_JWT_KEY_ID
# -> Don't forget to download the key (as .p8) and put the content in APPLE_JWT_PRIVATE_KEY_P8

AUTH_APPLE_ID="TLD.DOMAIN.web"
# TO GENERATE THIS ONE, FILL THE BELLOW FIELDS AND RUN THE FOLLOWING COMMAND
# npx tsx --env-file .env scripts/apple-secret.ts
AUTH_APPLE_SECRET="xxx"  # JWT signed with your Apple private key

# Found in https://developer.apple.com/account, scroll to Membership details
APPLE_JWT_TEAM_ID="xxx"
APPLE_JWT_PRIVATE_KEY_P8="-----BEGIN PRIVATE KEY-----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
xxxxxxxx
-----END PRIVATE KEY-----"
APPLE_JWT_KEY_ID="xxx"
