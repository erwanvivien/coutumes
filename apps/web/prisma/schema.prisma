// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output          = "./generated"
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto]
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email    String  @unique
  name     String  @db.VarChar(64)
  imageUrl String? @map("image_url")

  customerId String? @map("customer_id")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  emailVerifiedAt DateTime? @map("email_verified_at")

  UserAuth         UserAuth[]
  StoreOwner       StoreOwner[]
  SuperAdminStores Store[]

  @@map("user")
}

enum Provider {
  google
}

/// Whether the figures typed into a store's sheet are tax-excluded or tax-included.
enum RevenueBasis {
  ht
  ttc
}

/// What a member can do in a store: staff read the reports and prepare presentations, admins also
/// manage the store (settings, who has access, deleting it).
enum StoreRole {
  staff
  admin
}

model UserAuth {
  userId String @map("user_id") @db.Uuid
  User   User   @relation(fields: [userId], references: [id])

  provider Provider
  conf     Json     @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("user_auth")
}

/// A shop and the Google Sheet its figures are typed into. A user can own several, and a store
/// can have several owners (co-managed boutiques), each at its own URL slug.
model Store {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// URL-facing identifier, e.g. "boutique-lyon-part-dieu" in /boutique-lyon-part-dieu/2026-11
  slug        String  @unique @db.VarChar(80)
  name        String  @db.VarChar(80)
  /// Unique: a sheet belongs to one store, so nobody can attach (and read) someone else's sheet
  sheetId     String? @unique @map("sheet_id")
  useDemoData Boolean @default(false) @map("use_demo_data")

  /// Whether "Réalisé" and "Objectif" in the sheet are already tax-excluded (the default) or
  /// include VAT — figures are always normalized to HT before any KPI is computed.
  revenueBasis RevenueBasis @default(ht) @map("revenue_basis")
  /// VAT rate used to convert TTC figures to HT, as a fraction (0.2 = 20%)
  vatRate      Float        @default(0.2) @map("vat_rate")

  /// The store's creator, until they transfer it: always an admin, and nobody can remove them
  superAdminId String @map("super_admin_id") @db.Uuid
  SuperAdmin   User   @relation(fields: [superAdminId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  Owners       StoreOwner[]
  Presentation Presentation[]

  @@map("store")
}

/// Who has access to a store, and with which role: a many-to-many between users and stores.
model StoreOwner {
  storeId String @map("store_id") @db.Uuid
  Store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role StoreRole @default(staff)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_owner")
}

/// A month's or a week's report as presented to management: the editable blocks, and — once
/// published — a frozen copy of the blocks and figures behind an unguessable share link.
model Presentation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  storeId String @map("store_id") @db.Uuid
  Store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// "2026-11" for a month, "2026-10-12" (its Monday) for a week
  period String @db.VarChar(10)
  blocks Json   @db.JsonB

  shareToken  String?   @unique @map("share_token")
  snapshot    Json?     @db.JsonB
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, period])
  @@map("presentation")
}
