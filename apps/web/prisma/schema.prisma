// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  previewFeatures = ["postgresqlExtensions"]
  output          = "./generated"
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto]
}

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  email    String  @unique
  name     String  @db.VarChar(64)
  imageUrl String? @map("image_url")

  customerId String? @map("customer_id")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  emailVerifiedAt DateTime? @map("email_verified_at")

  UserAuth UserAuth[]
  Store    Store?

  @@map("user")
}

enum Provider {
  google
}

model UserAuth {
  userId String @map("user_id") @db.Uuid
  User   User   @relation(fields: [userId], references: [id])

  provider Provider
  conf     Json     @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, provider])
  @@map("user_auth")
}

/// A shop and the Google Sheet its figures are typed into. One per user, set up after first login.
model Store {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  ownerId String @unique @map("owner_id") @db.Uuid
  Owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String  @db.VarChar(80)
  /// Unique: a sheet belongs to one store, so nobody can attach (and read) someone else's sheet
  sheetId     String? @unique @map("sheet_id")
  useDemoData Boolean @default(false) @map("use_demo_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  Presentation Presentation[]

  @@map("store")
}

/// A month's report as presented to management: the editable blocks, and — once published — a
/// frozen copy of the blocks and figures behind an unguessable share link.
model Presentation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  storeId String @map("store_id") @db.Uuid
  Store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  /// "2026-11"
  month  String @db.VarChar(7)
  blocks Json   @db.JsonB

  shareToken  String?   @unique @map("share_token")
  snapshot    Json?     @db.JsonB
  publishedAt DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, month])
  @@map("presentation")
}
