# Copy to fastlane/.env (gitignored) and fill in locally, or export these in
# your shell / CI secrets store. Never commit real values.

# --- Android: Play Console ---
# Google removed the old "Setup > API access" page; service accounts are now
# created entirely in Google Cloud Console and then granted access in Play
# Console separately:
#   1. Cloud Console > IAM & Admin > Service Accounts > Create service account
#      (in the GCP project linked to your Play Console account).
#   2. Enable the "Google Play Android Developer API" for that project
#      (APIs & Services > Library).
#   3. Open the service account > Keys tab > Add key > Create new key > JSON
#      -- downloads the file this var should point to.
#   4. Play Console > Users and permissions > Invite new users > paste the
#      service account's email (ends in .iam.gserviceaccount.com) > grant it
#      "Release manager" (or Admin) access to this app.
# Needed to read the current live versionCode and to upload the AAB.
PLAY_STORE_JSON_KEY_FILE=/absolute/path/to/play-store-service-account.json

# Upload keystore (see scripts/generate-release-keystore.sh for a fresh one).
MOBILE_ANDROID_RELEASE_STORE_FILE=/absolute/path/to/upload-keystore.jks
MOBILE_ANDROID_RELEASE_STORE_PASSWORD=
MOBILE_ANDROID_RELEASE_KEY_ALIAS=
MOBILE_ANDROID_RELEASE_KEY_PASSWORD=

# --- iOS: App Store Connect ---
# API key from App Store Connect > Users and Access > Integrations > Team Keys (App Manager).
# Used for auth, reading the current live build number, and TestFlight/App
# Store uploads -- no Apple ID password or 2FA prompt needed.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILEPATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Developer Portal team id, only needed if your Apple account belongs to more
# than one team (used by get_certificates/get_provisioning_profile).
APPLE_TEAM_ID=
