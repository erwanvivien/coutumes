app_identifier("com.example.template") # iOS bundle id / Android applicationId

# Auth is handled by the App Store Connect API key set up in the Fastfile
# (before_all), so no Apple ID / password is needed here. Only set if your
# Apple account belongs to more than one team.
team_id(ENV["APPLE_TEAM_ID"]) if ENV["APPLE_TEAM_ID"]

for_platform :android do
  json_key_file(ENV["PLAY_STORE_JSON_KEY_FILE"])
  package_name("com.example.template")
end
