APP_IDENTIFIER = "com.example.template" # shared between Android applicationId and iOS bundle id
ANDROID_PACKAGE_NAME = APP_IDENTIFIER
IOS_SCHEME = "template"

# --- Android -----------------------------------------------------------
#
# Required env vars:
#   PLAY_STORE_JSON_KEY_FILE           path to the Play Console service account JSON
#   MOBILE_ANDROID_RELEASE_STORE_FILE       path to the upload keystore (.jks)
#   MOBILE_ANDROID_RELEASE_STORE_PASSWORD
#   MOBILE_ANDROID_RELEASE_KEY_ALIAS
#   MOBILE_ANDROID_RELEASE_KEY_PASSWORD
#
# See scripts/generate-release-keystore.sh to create the keystore once.

platform :android do
  desc "Read the highest versionCode live on Play across all tracks, bump past it, and persist to app.config.js"
  lane :bump_version do |options|
    # Play Store versionCodes are unique across the whole app, not per-track,
    # so we have to check every track -- not just the one we're releasing to --
    # or we risk recomputing a versionCode that's already live elsewhere (e.g.
    # the first `production` release colliding with an earlier `internal` one).
    all_tracks = ["internal", "alpha", "beta", "production"]
    live_codes = all_tracks.flat_map do |t|
      begin
        google_play_track_version_codes(package_name: ANDROID_PACKAGE_NAME, track: t) || []
      rescue StandardError => e
        # fastlane's supply client throws NoMethodError on `flat_map` for nil
        # instead of returning [] when the track has no releases yet -- true
        # for a brand new app/track that's never had a manual upload.
        UI.important("Could not read live versionCodes for track '#{t}' (likely no release yet): #{e.message}")
        []
      end
    end
    next_version_code = (live_codes.max || 0) + 1

    sh("cd .. && node scripts/set-native-version.js android #{next_version_code}")
    UI.success("Bumped Android versionCode to #{next_version_code}")
  end

  desc "Build a signed release AAB and upload it to Play Console. Usage: fastlane android release track:internal"
  lane :release do |options|
    UI.user_error!("Set MOBILE_ANDROID_RELEASE_STORE_FILE (see scripts/generate-release-keystore.sh)") unless ENV["MOBILE_ANDROID_RELEASE_STORE_FILE"]

    track = options[:track] || "internal"
    bump_version(track: track)

    sh("cd .. && npx expo prebuild -p android --clean")

    gradle(
      task: "bundle",
      build_type: "Release",
      project_dir: "android"
    )

    upload_to_play_store(
      package_name: ANDROID_PACKAGE_NAME,
      track: track,
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

# --- iOS -----------------------------------------------------------------
#
# Required env vars:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_FILEPATH   App Store Connect API key
#   APPLE_TEAM_ID                                 Developer Portal team id (fastlane match / cert)
#
# Uses an App Store Connect API key throughout (no Apple ID password / 2FA prompts),
# and `get_certificates`/`get_provisioning_profile` to fetch signing assets on demand
# instead of a separate `match` credentials repo.

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
  end

  desc "Read the highest build number on TestFlight (or App Store), bump past it, and persist to app.config.js"
  lane :bump_version do |options|
    live_build_number =
      if options[:app_store]
        begin
          app_store_build_number(app_identifier: APP_IDENTIFIER).to_i
        rescue StandardError
          0 # no live App Store version yet, e.g. very first release
        end
      else
        begin
          latest_testflight_build_number(app_identifier: APP_IDENTIFIER).to_i
        rescue StandardError
          0 # no TestFlight build yet, e.g. very first release
        end
      end
    next_build_number = live_build_number + 1

    sh("cd .. && node scripts/set-native-version.js ios #{next_build_number}")
    UI.success("Bumped iOS buildNumber to #{next_build_number}")
  end

  desc "Build a signed release IPA and upload it to TestFlight. Usage: fastlane ios release app_store:true"
  lane :release do |options|
    bump_version(app_store: options[:app_store])

    sh("cd .. && npx expo prebuild -p ios --clean")

    cocoapods(podfile: "ios/Podfile")

    get_certificates(output_path: "fastlane/certs")
    get_provisioning_profile(output_path: "fastlane/profiles", app_identifier: APP_IDENTIFIER)

    # A project that's never been opened in Xcode with a signed-in Apple ID has no
    # DEVELOPMENT_TEAM set and no automatic signing to fall back on. Point xcodebuild
    # at the profile/team fetched above explicitly.
    profile_name = lane_context[SharedValues::SIGH_NAME]
    build_app(
      workspace: "ios/#{IOS_SCHEME}.xcworkspace",
      scheme: IOS_SCHEME,
      export_method: "app-store",
      output_directory: "fastlane/builds",
      xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER=\"#{profile_name}\" CODE_SIGN_IDENTITY=\"Apple Distribution\"",
      export_options: {
        method: "app-store",
        provisioningProfiles: { APP_IDENTIFIER => profile_name }
      }
    )

    if options[:app_store]
      upload_to_app_store(
        submit_for_review: false,
        automatic_release: false,
        force: true,
        # precheck's In-app purchase check requires Apple ID login, which this
        # project doesn't use (App Store Connect API key only, see above) --
        # and it's moot anyway since submit_for_review is false.
        run_precheck_before_submit: false
      )
    else
      upload_to_testflight(skip_waiting_for_build_processing: true)
    end
  end

  desc "Re-push metadata/screenshots for the App Store version already created by `release app_store:true`, without rebuilding or re-uploading the binary"
  lane :push_metadata do
    upload_to_app_store(
      skip_binary_upload: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
