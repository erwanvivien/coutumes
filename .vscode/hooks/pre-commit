#!/bin/bash
# git config set core.hooksPath .vscode/hooks

echo "Checking for typescript errors..."
npx tsc --noEmit --incremental || exit 1
npm run check:lint || exit 1

function changed() {
    git --no-pager diff --exit-code -- "$1" > /dev/null
    result="$?"

    git --no-pager diff --exit-code --staged -- "$1" > /dev/null
    result=$((result | $?))
    
    if [ "$result" -ne 0 ]; then
        echo "Changes detected in $1"
        return 0  # Changed
    else
        echo "No changes detected in $1"
        return 1  # Not changed
    fi
}

# Check if the app has changed
if changed 'app'; then
    npx prettier --check app || exit 1
    npx check-unused-css app || exit 1
fi

if changed 'lib'; then
    npx prettier --check lib || exit 1
fi

if changed 'prisma'; then
    npx prettier --check prisma || exit 1
fi

if changed 'scripts'; then
    npx prettier --check scripts || exit 1
fi

if changed 'package.json'; then
    npx prettier --check package.json || exit 1
fi
