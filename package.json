{
  "name": "template",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev -w @template/web",
    "web:build": "npm run build -w @template/web",
    "mobile": "npm run start -w @template/mobile",
    "mobile:android": "npm run android -w @template/mobile",
    "mobile:ios": "npm run ios -w @template/mobile",
    "mobile:web": "npm run web -w @template/mobile",
    "lint": "npm run check:lint -w @template/web && npm run lint -w @template/mobile",
    "format:fix": "npm run format:fix -w @template/web && npm run format:fix -w @template/mobile",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.1.1"
  }
}
