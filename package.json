{
  "name": "template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:format": "npx prettier --check .",
    "check:types": "npx tsc --noEmit --incremental",
    "check:lint": "eslint",
    "validate": "npm run check:format && npm run check:types && npm run check:lint",
    "format:fix": "npx prettier --write . --list-different"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/json": "^1.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5",
    "typescript-plugin-css-modules": "^5.2.0"
  }
}
